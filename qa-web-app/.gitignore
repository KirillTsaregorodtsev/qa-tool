# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Volume — secrets and local runtime config never committed
volume/config/ssh_key
volume/config/app.env
volume/config/settings.json
volume/reports/*
!volume/reports/.gitkeep
volume/cache/*
!volume/cache/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/

# Misc
.DS_Store
*.log
